# ==== Bắt buộc ====
# Token lấy từ @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ==== Quyền quản trị ====
# ID Telegram của chủ bot, cách nhau bằng dấu phẩy. Những người này luôn được bỏ qua.
OWNER_IDS=

# Kênh/nhóm riêng để bot ghi log âm thầm (bot phải là admin ở đó).
# Để trống nếu không muốn log ra Telegram.
LOG_CHAT_ID=

# ==== Chế độ hoạt động ====
# ban    : xoá tin + ban vĩnh viễn (mặc định)
# mute   : xoá tin + cấm chat MUTE_SECONDS giây
# delete : chỉ xoá tin
# report : không làm gì, chỉ ghi log (dùng để chạy thử, khuyến nghị 1-2 ngày đầu)
ACTION=ban
MUTE_SECONDS=86400

# Ngưỡng điểm để bị xử lý. Càng thấp càng gắt. Mặc định 5.
SPAM_THRESHOLD=5

# Ngưỡng riêng cho thành viên mới (trong NEW_MEMBER_HOURS giờ đầu).
NEW_MEMBER_THRESHOLD=3
NEW_MEMBER_HOURS=24

# ==== Luật bật/tắt ====
# Chặn mọi tin nhắn chuyển tiếp (forward) từ người/kênh khác
BLOCK_FORWARDS=true
# Chỉ chặn forward của thành viên mới, còn thành viên cũ thì cho phép
BLOCK_FORWARDS_NEW_ONLY=false
# Chặn mọi link không nằm trong whitelist
BLOCK_LINKS=true
# Chỉ chặn link của thành viên mới
BLOCK_LINKS_NEW_ONLY=false
# Chặn tin nhắn gửi dưới danh nghĩa kênh (sender_chat) - vector spam rất phổ biến
BLOCK_CHANNEL_SENDERS=true

# Chặn mọi @username không nằm trong danh sách được phép.
# @ của admin nhóm luôn được phép tự động, không cần khai báo.
# Thêm @ khác bằng lệnh /addat trong nhóm hoặc nhắn riêng bot.
BLOCK_MENTIONS=true
# @ được phép sẵn từ lúc khởi động, cách nhau bằng dấu phẩy (không cần dấu @)
ALLOWED_USERNAMES=

# Quét mã QR trong ảnh (cần opencv-python-headless). Bot tải ảnh về, giải mã QR
# rồi soi nội dung bằng đúng bộ luật link/từ khoá. Tắt nếu nhóm nhiều ảnh và
# bạn muốn tiết kiệm băng thông.
SCAN_QR=true
# Bỏ qua ảnh lớn hơn mức này (byte) để không tốn băng thông.
QR_MAX_BYTES=5000000

# Đọc chữ nằm trong ảnh (OCR) rồi soi từ cấm. Tờ rơi quảng cáo lừa đảo thường
# không có caption - toàn bộ chữ nằm trong pixel, không có OCR là bot mù.
# Cần: apt install tesseract-ocr tesseract-ocr-vie (Linux),
# hoặc để sẵn tessdata/vie.traineddata trong thư mục bot (Windows).
SCAN_OCR=true
OCR_LANG=vie+eng
# Thu ảnh về cạnh dài này trước khi đọc. Thu quá nhỏ lại CHẬM hơn và đọc kém:
# đo được 800px bắt 10/20, 1600px bắt 13/20 mà chỉ tốn thêm 13% thời gian.
OCR_MAX_SIDE=1600
OCR_MAX_BYTES=5000000

# Tự xoá tin nhắn dịch vụ (loại tin xám do Telegram tự sinh) để nhóm sạch.
# Liệt kê cách nhau bằng dấu phẩy, hoặc dùng 'all' / 'none':
#   join      - "X đã tham gia nhóm"
#   leave     - "X đã rời nhóm"
#   pin       - "X đã ghim một tin nhắn" (tin vẫn được ghim, chỉ mất thông báo)
#   title     - đổi tên nhóm
#   photo     - đổi/xoá ảnh nhóm
#   videochat - bắt đầu/kết thúc cuộc gọi nhóm
#   forum     - tạo/sửa/đóng chủ đề trong nhóm forum
#   other     - boost, giveaway, hẹn giờ tự xoá, chia sẻ danh bạ...
DELETE_SERVICE_MESSAGES=join,leave,pin

# Domain được phép, cách nhau bằng dấu phẩy (tự động tính cả subdomain)
WHITELIST_DOMAINS=t.me,telegram.org,youtube.com,youtu.be,github.com,google.com,wikipedia.org

# ==== Cơ sở dữ liệu ====
DB_PATH=antispam.db
LOG_LEVEL=INFO
